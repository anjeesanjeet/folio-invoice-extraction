# ---- Vision model: anthropic or openai ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave empty unless your model needs it
LLM_TEMPERATURE=

# Prices in USD per 1M tokens, for cost tracking. Check your provider's current pricing.
ANTHROPIC_PRICE_INPUT_PER_MTOK=1.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=5.0
OPENAI_PRICE_INPUT_PER_MTOK=0.40
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60

# ---- Processing ----
MAX_PAGES=3
RENDER_SCALE=1.6
# Tax above this share of the taxable amount is flagged
MAX_TAX_RATE=0.30

# ---- Server ----
HOST=127.0.0.1
PORT=8200
DB_PATH=data/folio.db
